 
<div class="login-page">
  <div class="login-card">
    <h1>Sign in</h1>

    <p>Please sign in to continue voting.</p>

    <button
      type="button"
      class="login-button"
      onclick="window.Clerk.redirectToSignIn({
        returnBackUrl: 'http://localhost:3000/'
      });">
      Sign in with Clerk
    </button>
  </div>
</div>

<script>
  window.addEventListener("load", async function () {
    try {
      await window.Clerk.load();

      if (window.Clerk.session?.status === "active") {
        window.location.replace("http://localhost:3000/");
      }
    } catch (error) {
      console.error("Clerk redirect error:", error);
    }
  });
</script>
