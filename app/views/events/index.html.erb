<h1>Upcoming Events</h1>

<div class="events-container">
  <% @events.each do |event| %>
    <div class="event-card">

      <% if event.image_url.present? %>
        <%= image_tag event.image_url,
                      alt: event.title,
                      width: 300 %>
      <% end %>

      <h2><%= event.title %></h2>

      <p>
        <strong>Date:</strong>
        <%= event.starts_at&.strftime("%d %B %Y, %I:%M %p") || "TBA" %>
      </p>

      <p><%= truncate(event.description, length: 200) %></p>

      <% if event.event_url.present? %>
        <%= link_to "View Event", event.event_url,
                    target: "_blank",
                    rel: "noopener noreferrer" %>
      <% end %>

      
      <p>
        Upvotes: <%= event.votes.where(direction: "upvote").count %>
        |
        Downvotes: <%= event.votes.where(direction: "downvote").count %>
      </p>

      <%= form_with url: event_vote_path(event),
              method: :post,
              data: { turbo: false } do |form| %>
        <%= form.hidden_field :direction, value: "upvote" %>
        <%= form.submit "👍 Upvote" %>
      <% end %>


      <%= form_with url: event_vote_path(event),
              method: :post,
              data: { turbo: false } do |form| %>
        <%= form.hidden_field :direction, value: "downvote" %>
        <%= form.submit "👎 Downvote" %>
      <% end %>             


    </div>
  <% end %>
</div>
