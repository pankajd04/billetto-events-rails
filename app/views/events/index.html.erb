
<div class="events-page">
  <div class="events-header">
    <h1>Upcoming Events</h1>
    <p>Discover events and share your opinion by voting.</p>
  </div>

  <div class="events-grid">
    <% @events.each do |event| %>
      <div class="event-card">

        <% if event.image_url.present? %>
          <div class="event-image">
            <%= image_tag event.image_url, alt: event.title %>
          </div>
        <% end %>

        <div class="event-content">
          <h2><%= event.title %></h2>

          <p class="event-date">
            <span>📅</span>
            <%= event.starts_at&.strftime("%d %B %Y, %I:%M %p") || "Date to be announced" %>
          </p>

          <p class="event-description">
            <%= truncate(event.description, length: 180) %>
          </p>

          <% if event.event_url.present? %>
            <%= link_to "View Event ↗",
                        event.event_url,
                        target: "_blank",
                        rel: "noopener noreferrer",
                        class: "event-link" %>
          <% end %>

          <% counts = event.event_vote_count %>

          <div class="vote-summary">
            <div class="vote-count upvote-count">
              <span>👍</span>
              <div>
                <strong><%= counts&.upvotes_count || 0 %></strong>
                <small>Upvotes</small>
              </div>
            </div>

            <div class="vote-count downvote-count">
              <span>👎</span>
              <div>
                <strong><%= counts&.downvotes_count || 0 %></strong>
                <small>Downvotes</small>
              </div>
            </div>
          </div>

          <div class="vote-actions">
            <%= form_with url: event_vote_path(event),
                          method: :post,
                          data: { turbo: false } do |form| %>
              <%= form.hidden_field :direction, value: "upvote" %>
              <%= form.submit "👍 Upvote", class: "vote-button upvote-button" %>
            <% end %>

            <%= form_with url: event_vote_path(event),
                          method: :post,
                          data: { turbo: false } do |form| %>
              <%= form.hidden_field :direction, value: "downvote" %>
              <%= form.submit "👎 Downvote", class: "vote-button downvote-button" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
